generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MODERATOR
  USER
}

enum SubRole {
  TRUSTED
  COMMENTOR
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  CHECK_IN
  LIVE
  COMPLETED
  ARCHIVED
}

enum EntryType {
  FREE
  POINTS
  MONEY
  // Priced in the player's own cc balance — unlike MONEY (paid out of band,
  // needs an admin to verify), cc is a real in-system balance, so CC-priced
  // purchases deduct it directly at buy time. See frontoffice's buyShopItem.
  CC
}

enum ParticipationType {
  SOLO
  TEAM
}

enum TournamentRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// What an admin has triaged a ContactRequest as — drives which action panel
// shows on the report detail page (e.g. DEPOSIT_REQUEST reveals the "Add CC
// Coins" form). Starts GENERAL; only an admin changes it, as part of responding.
enum ContactType {
  GENERAL
  DEPOSIT_REQUEST
  ACCOUNT_ISSUE
  BUG_REPORT
  OTHER
}

enum ContactStatus {
  OPEN
  CLOSED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum EventType {
  COMMUNITY
  NEWS
  MAINTENANCE
  GIVEAWAY
  ANNOUNCEMENT
  PARTNERSHIP
}

enum ShopItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ShopItemCategory {
  AVATAR
  BADGE
  BOOST
  VOUCHER
  MERCH
  OTHER
}

enum ItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// XP_BOOST/POINTS_BOOST are percentage bumps applied to the economy field of
// the same name when a UserItem is consumed; CC_GRANT is a flat cc amount
// instead (see frontoffice's useItem action, which exhaustively switches on
// this). CC_GRANT items are how a shop CC-bundle purchase (see
// ShopItem.grantsItem) pays out once its ContactRequest is approved.
enum ItemEffectType {
  XP_BOOST
  POINTS_BOOST
  CC_GRANT
  // Flat points amount, not a percentage — mirrors CC_GRANT.
  POINTS_GRANT
}

enum BattlePassStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MarketplaceStatus {
  PENDING
  APPROVED
  DECLINED
  ARCHIVED
  SOLD
}

enum MarketplaceCategory {
  ACCOUNT
  IN_GAME_ITEM
  BOOST_SERVICE
  GEAR
  OTHER
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  username           String    @unique
  email              String    @unique
  fullName           String?
  phone              String?
  passwordHash       String
  role               Role      @default(USER)
  subRoles           SubRole[] @default([])
  // Independent flags, not a status enum: a banned user can't log in at all;
  // a blocked user can log in and use everything except join tournaments;
  // market/shop-blocked can log in and play but not use that one module.
  // Each *Until is the expiry — the restriction is only in effect while
  // the flag is true AND *Until is in the future (see lib/restrictions.ts).
  banned             Boolean   @default(false)
  bannedUntil        DateTime?
  blocked            Boolean   @default(false)
  blockedUntil       DateTime?
  marketBlocked      Boolean   @default(false)
  marketBlockedUntil DateTime?
  shopBlocked        Boolean   @default(false)
  shopBlockedUntil   DateTime?
  points             Int       @default(0)
  // The site's real-money-backed currency (1 cc = 1 DT) — can only ever be
  // credited by an admin through an open ContactRequest (see addCcCoins).
  ccCoins            Int       @default(0)
  level              Int       @default(1)
  // XP toward the *next* level — always kept < the current level's required XP
  // (see lib/level-xp.ts: normalizeLevelXp carries any overflow into level-ups
  // whenever this or level is set). Required XP per 5-level tier is
  // admin-configured via LevelXpRule (the /levels page).
  xp                 Int       @default(0)
  avatarUrl          String?
  // Frontoffice-owned fields, mirrored here only so this schema's `db push`
  // doesn't drop indexes/data the front office depends on (friendCode's
  // unique index in particular — see the frontoffice User model comment).
  // inventoryPublic mirrored too even though it has no index of its own — a
  // moderation-relevant privacy flag is cheap to keep in sync, unlike
  // frontoffice's purely cosmetic profileTheme, which this schema does NOT
  // mirror because backoffice has no use for it.
  bio                String?
  friendCode         String?   @unique
  bannerImageUrl     String?
  inventoryPublic    Boolean   @default(true)
  // Mirrored for the same reason as friendCode above: only discordId carries
  // an index the front office depends on (see its User model comment and
  // /discord-bot) — not @unique itself (MongoDB has no sparse/partial unique
  // support in Prisma, and nearly every row lacks it). discordUsername/
  // discordLinkedAt aren't mirrored since they have no index and back office
  // has no use for them, same tradeoff as profileTheme.
  discordId          String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  participations       TournamentParticipant[]
  eventAttendances     EventAttendee[]
  marketplaceListings  MarketplaceListing[]
  marketplacePurchases MarketplaceListing[]    @relation("MarketplacePurchases")
  consumableItems      UserItem[]
  wheelSpin            UserWheelSpin?
  dailyReward          UserDailyReward?
  submittedTournamentRegistrations TournamentRegistration[]       @relation("SubmittedTournamentRegistrations")
  tournamentRegistrationSlots      TournamentRegistrationMember[]
  contactRequests                  ContactRequest[]               @relation("ContactRequestOwner")
  contactMessagesAuthored          ContactMessage[]                @relation("ContactMessageAuthor")

  @@index([discordId])
  @@map("users")
}

// Admin-configured XP curve: `tier` groups 5 consecutive levels — tier 1 =
// levels 1-5, tier 2 = levels 6-10, etc. (see lib/level-xp.ts:tierForLevel) —
// and xpPerLevel is how much XP each level within that band costs. A level
// beyond the highest configured tier falls back to that tier's xpPerLevel,
// so an admin only has to configure early tiers explicitly; nothing existing
// here at all falls back further to a hardcoded DEFAULT_XP_PER_LEVEL.
model LevelXpRule {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tier       Int      @unique
  xpPerLevel Int
  updatedAt  DateTime @updatedAt

  @@map("level_xp_rules")
}

model Game {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  slug   String  @unique
  name   String
  icon   String?
  active Boolean @default(true)

  tournaments         Tournament[]
  events              Event[]
  shopItems           ShopItem[]
  marketplaceListings MarketplaceListing[]

  @@map("games")
}

model Tournament {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  additionalInfo     String?
  gameId             String            @db.ObjectId
  game               Game              @relation(fields: [gameId], references: [id])
  status             TournamentStatus  @default(DRAFT)
  entryType          EntryType         @default(FREE)
  entryCost          Int               @default(0)
  prizePool          Int               @default(0)
  participationType  ParticipationType @default(SOLO)
  backgroundImageUrl String?
  logoImageUrl       String?
  startAt            DateTime
  createdAt          DateTime          @default(now())
  // Nullable = unlimited, same convention as Event.capacity. For SOLO this
  // caps total registered players; TEAM tournaments have no real Team entity
  // (see TournamentParticipant.teamName), so it caps the number of distinct
  // team names among participants instead — see lib/tournament-capacity.ts.
  capacity           Int?
  // Admin-entered skill-level label for the tournament as a whole (e.g. "Gold
  // Tier") with its own uploaded image — not derived from participants' own
  // ranks/levels, just a badge the admin sets when creating the tournament.
  averageRankName    String?
  averageRankImageUrl String?
  // Freeform admin-entered region label (e.g. "MENA", "Europe") — no fixed
  // enum, since the set of regions isn't platform-defined anywhere else.
  region             String?
  // TEAM only — caps how many players (captain + added members) a single
  // TournamentRegistration roster can have. Nullable = unlimited. Enforced at
  // submission (front office) and re-checked at approval (see
  // approveTournamentRegistration), same pattern as `capacity`.
  maxTeamSize        Int?

  participants  TournamentParticipant[]
  registrations TournamentRegistration[]

  @@map("tournaments")
}

// Recorded once the front-end registration flow signs a user up for a
// tournament. For TEAM tournaments this is only ever created by
// approveTournamentRegistration below, once a TournamentRegistration is
// approved — teamName/teamTag/teamLogoUrl are snapshotted from that
// registration at approval time (like AuditLog.actorUsername).
model TournamentParticipant {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String     @db.ObjectId
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  userId       String     @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])
  teamName     String?
  teamTag      String?
  teamLogoUrl  String?
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@map("tournament_participants")
}

// A team's registration *request* for one TEAM tournament, submitted from
// the front office's "Participate" modal — reviewed here. Approving (see
// approveTournamentRegistration in tournaments/actions.ts) creates the real
// TournamentParticipant rows, one per member (charging each member's points
// first if the tournament is a POINTS entry, same as the front office's
// existing per-player joinTournament charge); rejecting creates nothing.
model TournamentRegistration {
  id            String                       @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId  String                       @db.ObjectId
  tournament    Tournament                   @relation(fields: [tournamentId], references: [id])
  teamName      String
  teamTag       String
  teamLogoUrl   String?
  status        TournamentRegistrationStatus @default(PENDING)
  submittedById String                       @db.ObjectId
  submittedBy   User                         @relation("SubmittedTournamentRegistrations", fields: [submittedById], references: [id])
  createdAt     DateTime                     @default(now())
  respondedAt   DateTime?
  // First-round bracket position (0-indexed), assigned once at approval time —
  // see approveTournamentRegistration and lib/bracket.ts.
  bracketSlot   Int?

  members TournamentRegistrationMember[]

  @@index([tournamentId, status])
  @@map("tournament_registrations")
}

model TournamentRegistrationMember {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  registrationId String                 @db.ObjectId
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id])
  userId         String                 @db.ObjectId
  user           User                   @relation(fields: [userId], references: [id])

  @@unique([registrationId, userId])
  @@map("tournament_registration_members")
}

// Community events / news / maintenance windows shown alongside tournaments —
// non-competitive, so no prize pool or entry cost like Tournament has.
model Event {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  additionalInfo     String?
  type               EventType   @default(COMMUNITY)
  status             EventStatus @default(DRAFT)
  gameId             String?     @db.ObjectId
  game               Game?       @relation(fields: [gameId], references: [id])
  location           String?
  capacity           Int?
  backgroundImageUrl String?
  logoImageUrl       String?
  startAt            DateTime
  endAt              DateTime?
  createdAt          DateTime    @default(now())

  attendees EventAttendee[]

  @@map("events")
}

// Recorded once the front-end RSVP flow (built separately) signs a user up
// for an event.
model EventAttendee {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId  String   @db.ObjectId
  event    Event    @relation(fields: [eventId], references: [id])
  userId   String   @db.ObjectId
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_attendees")
}

// Admin-curated storefront items — priced in points or money (reuses Tournament's
// EntryType). Most categories are still display-only from this app's side (no
// order/ownership model). Items with grantsItem set (the cc bundles) ARE
// purchasable from the front office: buying one opens a ContactRequest instead
// of granting anything directly — approving that ticket here (see reports'
// approveShopPurchase) is what actually adds grantsItem to the user's inventory.
model ShopItem {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  category     ShopItemCategory @default(OTHER)
  status       ShopItemStatus   @default(DRAFT)
  priceType    EntryType        @default(POINTS)
  price        Int              @default(0)
  stock        Int?
  gameId       String?          @db.ObjectId
  game         Game?            @relation(fields: [gameId], references: [id])
  imageUrl     String?
  createdAt    DateTime         @default(now())
  grantsItemId String?          @db.ObjectId
  grantsItem   Item?            @relation("ShopItemGrant", fields: [grantsItemId], references: [id])
  // Purchase flow for grantsItem-linked listings: true (default) opens a
  // ContactRequest for an admin to approve, same as today; false grants the
  // item the moment someone buys it, no review step. Irrelevant when
  // grantsItemId is unset (nothing is purchasable yet either way).
  needsConfirmation Boolean     @default(true)

  purchaseReports ContactRequest[]

  @@map("shop_items")
}

// Admin-defined consumable items with a gameplay effect (e.g. "XP Boost" at
// effectValue 25 = +25%, or "25 CC Voucher" at CC_GRANT/25) — distinct from
// ShopItem, which is a cosmetic/storefront good with no effect of its own
// (though a ShopItem can *grant* one of these on purchase approval — see
// ShopItem.grantsItem). Most items still only reach a user's inventory via a
// direct admin grant (see UserItem below and grantItem in users/actions.ts),
// then get consumed through the front office's "Use" action, which applies
// the effect and decrements the grant.
model Item {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status      ItemStatus     @default(DRAFT)
  effectType  ItemEffectType @default(XP_BOOST)
  effectValue Int            @default(0)
  imageUrl    String?
  createdAt   DateTime       @default(now())

  grants             UserItem[]
  freeTierRewards    BattlePassTier[] @relation("BattlePassFreeReward")
  premiumTierRewards BattlePassTier[] @relation("BattlePassPremiumReward")
  wheelSlot          LuckyWheelSlot?
  dailyRewardDays    DailyRewardDay[]
  shopItemGrants     ShopItem[]       @relation("ShopItemGrant")

  @@map("items")
}

// An optional override of a single rank's name/image, managed from this
// app's /ranks page. The rank ladder itself (which level bands map to which
// tier index, 0-18) is a fixed constant in code (see lib/rank-tiers.ts's
// DEFAULT_RANK_TIERS, mirrored in frontoffice's lib/rank.ts) rather than
// living here — a row only exists once an admin actually customizes that
// tier; frontoffice falls back to the hardcoded default (name + one of the
// bundled /ranks/*.png images) when no row is present.
model RankTier {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  tier     Int     @unique
  name     String?
  imageUrl String?

  @@map("rank_tiers")
}

// One admin grant of an Item to a user's inventory — quantity stacks repeat
// grants of the same item instead of creating duplicate rows (unlike
// UserInventoryItem's one-time ShopItem ownership, these are consumable:
// using one via the front office's "Use" action decrements quantity, deleting
// the row once it hits 0).
model UserItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  itemId     String   @db.ObjectId
  item       Item     @relation(fields: [itemId], references: [id])
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_items")
}

// Admin-configured Battle Pass season — a points-gated reward ladder shown
// read-only in the front office (Unlock Premium is a disabled "Coming soon"
// button, same precedent as ShopItemCard: no purchase/point-deduction flow
// exists yet, only display). Multiple seasons can exist; the front office
// shows whichever has status ACTIVE (ties broken by startAt desc). startAt/
// endAt are both required and are informational/display fields only, not
// the gating mechanism — unlike Event.endAt, a season always has a defined end.
model BattlePass {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String?
  status            BattlePassStatus @default(DRAFT)
  premiumPointsCost Int              @default(0)
  startAt           DateTime
  endAt             DateTime
  createdAt         DateTime         @default(now())

  tiers BattlePassTier[]

  @@map("battle_passes")
}

// One rung of a season's reward ladder. Rewards are real Item rows (picked
// from the admin's Items catalog), not freeform text — both slots are
// optional since a newly-added tier starts with neither set (see
// addBattlePassTier), and an admin may only want to fill in one side.
model BattlePassTier {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  battlePassId  String     @db.ObjectId
  battlePass    BattlePass @relation(fields: [battlePassId], references: [id])
  tier          Int
  freeItemId    String?    @db.ObjectId
  freeItem      Item?      @relation("BattlePassFreeReward", fields: [freeItemId], references: [id])
  premiumItemId String?    @db.ObjectId
  premiumItem   Item?      @relation("BattlePassPremiumReward", fields: [premiumItemId], references: [id])

  @@unique([battlePassId, tier])
  @@index([battlePassId])
  @@map("battle_pass_tiers")
}

// One slice of the Lucky Wheel — points at a real Item and carries a
// percentage chance. Weights are stored as admin-entered percentages (1-100,
// validated in luckyWheelSlotSchema) but spinWheel normalizes across whatever
// total is actually configured rather than requiring them to sum to exactly
// 100, so the wheel still works correctly even mid-edit. One slot per item
// (@@unique) — grant a bigger share by raising that item's weight, not by
// adding it twice.
model LuckyWheelSlot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId    String   @unique @db.ObjectId
  item      Item     @relation(fields: [itemId], references: [id])
  // Float, not Int — admins need sub-1% odds (e.g. 0.1%) for rare items.
  weight    Float    @default(1)
  createdAt DateTime @default(now())

  @@map("lucky_wheel_slots")
}

// One user's Lucky Wheel cooldown — a single row per user, overwritten on
// each spin. Up to 4 spins per UTC calendar day, 1st free and the rest cost
// cc (see frontoffice's spinWheel action and lib/lucky-wheel.ts); this app
// never writes it, only the front office does.
model UserWheelSpin {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  lastSpinAt DateTime
  spinsToday Int      @default(0)

  @@map("user_wheel_spins")
}

// One rung of the Daily Reward ladder — day is 1-indexed and admin-assigned
// (mirrors BattlePassTier's per-tier-row pattern: a blank day is added first
// via addDailyRewardDay, then the admin picks its item via the row's own save
// form, so itemId starts nullable). The ladder wraps: claiming past the
// highest configured day loops back to day 1 (see frontoffice's
// claimDailyReward action).
model DailyRewardDay {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  day    Int    @unique
  itemId String? @db.ObjectId
  item   Item?  @relation(fields: [itemId], references: [id])

  @@map("daily_reward_days")
}

// A user's progress through the Daily Reward ladder. currentDay is the day
// they'll claim next; lastClaimedAt gates re-claiming (must be a new UTC
// calendar day) and detects a missed day — claiming on anything later than
// the day right after lastClaimedAt resets currentDay back to 1 (see
// frontoffice's claimDailyReward action). This app never writes it, only the
// front office does.
model UserDailyReward {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @unique @db.ObjectId
  user          User      @relation(fields: [userId], references: [id])
  currentDay    Int       @default(1)
  lastClaimedAt DateTime?

  @@map("user_daily_rewards")
}

// Player-to-player trading listings. Admin-added listings are auto-approved
// (the admin authored them); listings submitted by users through the front-end
// app (built separately) start PENDING and need an admin to approve/decline
// before they're shown.
model MarketplaceListing {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  category    MarketplaceCategory @default(OTHER)
  status      MarketplaceStatus   @default(PENDING)
  priceType   EntryType           @default(MONEY)
  price       Int                 @default(0)
  gameId      String?             @db.ObjectId
  game        Game?               @relation(fields: [gameId], references: [id])
  sellerId    String              @db.ObjectId
  seller      User                @relation(fields: [sellerId], references: [id])
  // Set together when the front office's buy flow sells a POINTS/FREE listing
  // (schema mirror only — that flow lives in frontoffice; this just keeps the
  // enum/fields in sync so this app's Prisma client can read SOLD documents).
  buyerId     String?             @db.ObjectId
  buyer       User?               @relation("MarketplacePurchases", fields: [buyerId], references: [id])
  soldAt      DateTime?
  imageUrl    String?
  createdAt   DateTime            @default(now())

  @@index([status])
  @@map("marketplace_listings")
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Int
  currency  String   @default("TND")
  createdAt DateTime @default(now())

  @@map("transactions")
}

// A denormalized activity trail on a user account: who (actor) did what (action)
// to whom (targetUserId), and when. actorUsername is snapshotted at write time so
// the log stays readable even if the actor's own username later changes.
model AuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  targetUserId  String   @db.ObjectId
  actorId       String   @db.ObjectId
  actorUsername String
  action        String
  details       String?
  createdAt     DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@map("audit_logs")
}

// Free-text staff notes on a user account — distinct from AuditLog: notes are
// manually written commentary, not automatically recorded actions.
model Note {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  targetUserId   String   @db.ObjectId
  authorId       String   @db.ObjectId
  authorUsername String
  body           String
  createdAt      DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@map("notes")
}

// A support ticket opened from the front office's "Contact an admin" flow —
// the whole thing is a chat (see ContactMessage) rather than a single
// message. `type` starts GENERAL and is only ever changed by an admin while
// responding (see setReportType) — it drives which extra action panel shows
// on the report detail page (DEPOSIT_REQUEST -> "Add CC Coins"). Status gates
// that same action: CC can only ever be credited while status is OPEN, never
// through a direct economy edit (see addCcCoins).
model ContactRequest {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId    String        @db.ObjectId
  user      User          @relation("ContactRequestOwner", fields: [userId], references: [id])
  subject   String
  type      ContactType   @default(GENERAL)
  status    ContactStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  closedAt  DateTime?
  // Set only when this ticket was auto-opened by a shop cc-bundle purchase
  // (see frontoffice's buyShopItem) — drives the Approve/Reject purchase
  // panel on the report detail page instead of the generic type-select +
  // Add CC Coins panel.
  shopItemId String?      @db.ObjectId
  shopItem   ShopItem?    @relation(fields: [shopItemId], references: [id])

  messages ContactMessage[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
  @@map("contact_requests")
}

// One chat message in a ContactRequest thread. isAdmin is set by which app's
// action created it (frontoffice's sendContactMessage always false, back
// office's replyToReport/addCcCoins always true) rather than checked from the
// author's role.
model ContactMessage {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  contactRequestId String         @db.ObjectId
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id])
  authorId         String         @db.ObjectId
  author           User           @relation("ContactMessageAuthor", fields: [authorId], references: [id])
  isAdmin          Boolean        @default(false)
  body             String
  // Set when the message is (or includes) an attached image — e.g. a buyer's
  // proof-of-payment screenshot replying to a MONEY-priced purchase request.
  // body can be empty ("") when the message is image-only.
  imageUrl         String?
  createdAt        DateTime       @default(now())

  @@index([contactRequestId, createdAt])
  @@map("contact_messages")
}

// Admin-managed "where to send money" list (e.g. name "D17", details
// "22688314") — frontoffice's buyShopItem lists these in the auto-generated
// message on a MONEY-priced purchase request, so the buyer knows where to
// pay before an admin confirms receipt and approves.
model PaymentMethod {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  details   String
  createdAt DateTime @default(now())

  @@map("payment_methods")
}

// Admin-controlled overrides for the front office navbar's items (see
// frontoffice's lib/nav-items.ts and this app's lib/frontoffice-nav-items.ts,
// which must list the same keys). A key with no row here just uses its
// static default (enabled, in array order) — rows only exist once an admin
// actually changes something, same "override, not full source of truth"
// pattern as RankTier.
model NavItemConfig {
  id      String    @id @default(auto()) @map("_id") @db.ObjectId
  key     String    @unique
  enabled Boolean   @default(true)
  order   Int
  // Small red callout on the item's label in the front office navbar — null
  // means no badge. Admin-set from /navigation, independent of enabled/order.
  badge   NavBadge?

  @@map("nav_item_configs")
}

enum NavBadge {
  HOT
  NEW
}
